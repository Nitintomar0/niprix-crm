# Copy to .env for local development. Do not use this placeholder in production.
SECRET_KEY=replace-with-a-unique-local-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Set distinct values in local/production secret configuration; never expose them to the frontend.
NIPRIX_META_WEBHOOK_SECRET=replace-with-meta-webhook-signing-secret
NIPRIX_WEBSITE_WEBHOOK_SECRET=replace-with-website-webhook-signing-secret
# Redis is required for transient live attendance locations and WebSocket relay.
REDIS_URL=redis://127.0.0.1:6379/0
LIVE_LOCATION_TTL_SECONDS=600
LIVE_LOCATION_STALE_SECONDS=180
LIVE_LOCATION_MIN_UPDATE_SECONDS=45
